{
 "uid": "nira-overview",
 "title": "Nira \u2014 network overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "nira"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Height",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(cometbft_consensus_height)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Validators",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(cometbft_consensus_validators)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Missing voting power",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(cometbft_consensus_missing_validators_power / cometbft_consensus_validators_power)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Byzantine validators",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
