   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(cometbft_consensus_byzantine_validators)"
    }
   ]
  },
  {
